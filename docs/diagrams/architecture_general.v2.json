  "cards": [
    {
      "dot": "cyan",
      "title": "Capa Cliente & Edge",
      "items": [
        "React Web App gestiona la sesión SSO y captura WebCam interactiva",
        "Edge Gateway captura la cámara CCTV (RTSP) y filtra parpadeos con una FSM de EAR local",
        "Nginx asegura terminación SSL y mitigación DoS por rate-limiting",
        "El canal M2M del Edge Gateway omite el proxy y ataca el backend directamente en :8000"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inferencia & Biometría",
      "items": [
        "base64_to_image() centraliza la sanitización de tramas en memoria",
        "MediaPipe computa EAR (parpadeo), MAR (boca) y pose 3D de cabeza",
        "Motor LBP evalúa entropía textural contra ataques de presentación 2D",
        "ArcFace genera embeddings de 512D para comparación biométrica"
      ]
    },
    {
      "dot": "rose",
      "title": "Persistencia & Confianza",
      "items": [
        "ChromaDB efectúa indexación y búsqueda por similitud de cosenos",
        "SQLite resguarda perfiles, políticas ACL y dispositivos IoT enrolados",
        "Ganache registra hashes de autenticación vía Smart Contract desacoplado"
      ]
    }
