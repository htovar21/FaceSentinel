    {
      "dot": "cyan",
      "title": "Políticas de Inspección Anti-Spoofing",
      "items": [
        "active: reto interactivo de parpadeo (EAR), giro cefálico (Yaw) y apertura bucal (MAR)",
        "passive: Extracción pasiva de textura LBP y EAR sin cooperación activa del usuario",
        "none / bypass: Inferencia directa 1-shot o cámara Edge en zona física de alta confianza"
      ]
    },
    {
      "dot": "emerald",
      "title": "Resiliencia & Tolerancia a Fallos",
      "items": [
        "HTTP 422: Captura tramas base64 corruptas protegiendo los workers de FastAPI",
        "Audit Ganache: Notarización inmutable con fallback local si la blockchain no responde",
        "Fail-Closed: Toda anomalía o denegación de ACL bloquea la señal M2M y deniega el token"
      ]
    }
